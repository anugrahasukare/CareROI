<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CareROI — Hospital Intelligence Dashboard</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
*{box-sizing:border-box}

body{
    margin:0;
    font-family:Inter,Segoe UI,Arial,sans-serif;
    background:#f5f7fb;
    color:#172033
}

.app{display:flex;min-height:100vh}

.sidebar{
    width:245px;
    background:#101828;
    color:#fff;
    padding:24px 16px;
    position:fixed;
    height:100vh;
    overflow-y:auto
}

.logo{
    font-size:22px;
    font-weight:800;
    padding:8px 12px 30px
}

.logo span{
    font-weight:400;
    color:#98a2b3
}

.nav button{
    display:block;
    width:100%;
    padding:13px 14px;
    margin:5px 0;
    border:0;
    border-radius:9px;
    background:transparent;
    color:#c9d1dc;
    text-align:left;
    font-size:14px;
    cursor:pointer
}

.nav button.active,
.nav button:hover{
    background:#1d2939;
    color:#fff
}

.main{
    margin-left:245px;
    width:calc(100% - 245px);
    padding:28px 34px
}

.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:24px
}

.top h1{
    margin:0;
    font-size:27px
}

.top p{
    margin:5px 0 0;
    color:#667085;
    font-size:14px
}

select,.btn{
    border:1px solid #d0d5dd;
    background:#fff;
    padding:10px 13px;
    border-radius:8px
}

.btn{
    cursor:pointer;
    font-weight:600
}

.btn.primary{
    background:#175cd3;
    color:white;
    border-color:#175cd3
}

.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px
}

.card{
    background:#fff;
    border:1px solid #eaecf0;
    border-radius:12px;
    padding:20px;
    box-shadow:0 1px 2px #00000008
}

.label{
    color:#667085;
    font-size:13px
}

.value{
    font-size:27px;
    font-weight:750;
    margin:9px 0
}

.delta{
    font-size:12px;
    color:#039855
}

.delta.warning{
    color:#b54708
}

.delta.danger{
    color:#b42318
}

.grid{
    display:grid;
    grid-template-columns:1.5fr 1fr;
    gap:18px;
    margin-top:18px
}

.grid3{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-top:18px
}

.panel{
    background:#fff;
    border:1px solid #eaecf0;
    border-radius:12px;
    padding:20px
}

.panel h3{
    margin:0 0 16px;
    font-size:16px
}

.panel h4{
    margin:0 0 8px
}

.chartbox{
    height:290px
}

.smallchart{
    height:230px
}

.insight{
    display:flex;
    gap:12px;
    padding:14px;
    border:1px solid #eaecf0;
    border-radius:9px;
    margin-bottom:10px
}

.dot{
    width:9px;
    height:9px;
    min-width:9px;
    border-radius:50%;
    margin-top:5px;
    background:#12b76a
}

.warn .dot{background:#f79009}
.bad .dot{background:#f04438}

.insight b{
    font-size:14px
}

.insight p{
    margin:5px 0 0;
    color:#667085;
    font-size:12px;
    line-height:1.5
}

table{
    width:100%;
    border-collapse:collapse;
    font-size:13px
}

th,td{
    text-align:left;
    padding:13px 10px;
    border-bottom:1px solid #eaecf0
}

th{
    color:#667085;
    font-weight:600
}

.pill{
    padding:4px 8px;
    border-radius:20px;
    font-size:11px
}

.good{
    background:#ecfdf3;
    color:#027a48
}

.medium{
    background:#fffaeb;
    color:#b54708
}

.poor{
    background:#fef3f2;
    color:#b42318
}

.blue{
    background:#eff8ff;
    color:#175cd3
}

.page{
    display:none
}

.page.active{
    display:block
}

.formgrid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px
}

.formgrid label{
    font-size:12px;
    color:#667085
}

.formgrid input,
.formgrid select{
    width:100%;
    margin-top:6px;
    padding:10px;
    border:1px solid #d0d5dd;
    border-radius:8px
}

.result{
    margin-top:18px;
    padding:18px;
    background:#f8fafc;
    border-radius:10px;
    line-height:1.8
}

.kpi{
    padding:16px;
    border-radius:10px;
    background:#f8fafc;
    margin-bottom:10px
}

.kpi-title{
    color:#667085;
    font-size:12px
}

.kpi-value{
    font-size:22px;
    font-weight:700;
    margin-top:5px
}

.progress{
    height:8px;
    background:#eaecf0;
    border-radius:20px;
    overflow:hidden;
    margin-top:8px
}

.progress div{
    height:100%;
    background:#175cd3
}

.section-title{
    margin-top:28px;
    margin-bottom:12px
}

.decision{
    border-left:4px solid #175cd3;
    padding:15px;
    background:#f8fafc;
    margin-bottom:10px;
    border-radius:6px
}

.decision strong{
    display:block;
    margin-bottom:5px
}

.metric-good{color:#027a48}
.metric-warning{color:#b54708}
.metric-bad{color:#b42318}

@media(max-width:1100px){
    .cards{
        grid-template-columns:repeat(2,1fr)
    }

    .grid,.grid3{
        grid-template-columns:1fr
    }

    .formgrid{
        grid-template-columns:1fr 1fr
    }
}

@media(max-width:700px){
    .sidebar{
        width:190px
    }

    .main{
        margin-left:190px;
        width:calc(100% - 190px);
        padding:20px
    }

    .cards{
        grid-template-columns:1fr
    }

    .formgrid{
        grid-template-columns:1fr
    }
}
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->

<aside class="sidebar">

<div class="logo">
CareROI <span>Intelligence</span>
</div>

<div class="nav">

<button class="active"
onclick="showPage('overview',this)">
◈ Executive Overview
</button>

<button onclick="showPage('financial',this)">
₹ Financial Analytics
</button>

<button onclick="showPage('resources',this)">
◫ Resources
</button>

<button onclick="showPage('operations',this)">
▦ Operations
</button>

<button onclick="showPage('quality',this)">
♥ Quality & Safety
</button>

<button onclick="showPage('outcomes',this)">
◉ Patient Outcomes
</button>

<button onclick="showPage('departments',this)">
▤ Departments
</button>

<button onclick="showPage('roi',this)">
◎ ROI Calculator
</button>

<button onclick="showPage('predictions',this)">
⌁ Predictions
</button>

<button onclick="showPage('decisions',this)">
✓ Decision Support
</button>

</div>
</aside>


<main class="main">


<!-- ================================================= -->
<!-- OVERVIEW -->
<!-- ================================================= -->

<section id="overview" class="page active">

<div class="top">

<div>
<h1>Hospital Performance Overview</h1>
<p>Centralized financial, operational, quality and patient intelligence</p>
</div>

<select onchange="updatePeriod(this.value)">
<option>Last 30 days</option>
<option>Last 90 days</option>
<option>Year to date</option>
</select>

</div>


<div class="cards">

<div class="card">
<div class="label">Total Revenue</div>
<div class="value" id="rev">₹45.8L</div>
<div class="delta">↑ 8.4% vs previous period</div>
</div>

<div class="card">
<div class="label">Operating Cost</div>
<div class="value" id="cost">₹28.4L</div>
<div class="delta">↓ 3.1% vs previous period</div>
</div>

<div class="card">
<div class="label">Staff Utilization</div>
<div class="value">82%</div>
<div class="delta">↑ 5.2% efficiency</div>
</div>

<div class="card">
<div class="label">Bed Occupancy</div>
<div class="value">84.5%</div>
<div class="delta">186 / 220 beds occupied</div>
</div>

<div class="card">
<div class="label">Patient Throughput</div>
<div class="value">2,170</div>
<div class="delta">↑ 7.8% this period</div>
</div>

<div class="card">
<div class="label">Readmission Rate</div>
<div class="value">6.4%</div>
<div class="delta warning">Target: &lt; 5%</div>
</div>

<div class="card">
<div class="label">Patient Satisfaction</div>
<div class="value">87%</div>
<div class="delta">↑ 3.6% improvement</div>
</div>

<div class="card">
<div class="label">Treatment Success</div>
<div class="value">92%</div>
<div class="delta">↑ 2.1% improvement</div>
</div>

</div>


<div class="grid">

<div class="panel">

<h3>Department Efficiency</h3>

<div class="chartbox">
<canvas id="deptChart"></canvas>
</div>

</div>


<div class="panel">

<h3>Management Insights</h3>

<div class="insight">

<div class="dot"></div>

<div>
<b>Cardiology is highly efficient</b>

<p>
90% staff utilization with strong revenue generation.
</p>
</div>

</div>


<div class="insight warn">

<div class="dot"></div>

<div>
<b>Orthopedics needs review</b>

<p>
65% utilization and relatively high operating cost.
</p>
</div>

</div>


<div class="insight bad">

<div class="dot"></div>

<div>
<b>Readmission rate above target</b>

<p>
Current readmission rate is 6.4%. Investigate high-risk treatment pathways.
</p>
</div>

</div>


<div class="insight">

<div class="dot"></div>

<div>
<b>Patient satisfaction improving</b>

<p>
Satisfaction increased to 87%, primarily due to improved OPD experience.
</p>
</div>

</div>

</div>

</div>


<div class="panel" style="margin-top:18px">

<h3>Institutional Health Score</h3>

<div class="grid3">

<div class="kpi">
<div class="kpi-title">Financial Health</div>
<div class="kpi-value metric-good">88 / 100</div>
</div>

<div class="kpi">
<div class="kpi-title">Operational Efficiency</div>
<div class="kpi-value metric-good">84 / 100</div>
</div>

<div class="kpi">
<div class="kpi-title">Quality & Safety</div>
<div class="kpi-value metric-warning">79 / 100</div>
</div>

</div>

</div>

</section>



<!-- ================================================= -->
<!-- FINANCIAL -->
<!-- ================================================= -->

<section id="financial" class="page">

<div class="top">

<div>
<h1>Financial Analytics</h1>
<p>Revenue, expenditure, profitability and cost efficiency</p>
</div>

</div>


<div class="cards">

<div class="card">
<div class="label">Revenue</div>
<div class="value">₹45.8L</div>
<div class="delta">↑ 8.4%</div>
</div>

<div class="card">
<div class="label">Expenditure</div>
