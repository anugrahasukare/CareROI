let investment=
Number(document.getElementById('investment').value);

let benefit=
Number(document.getElementById('benefit').value);

let cost=
Number(document.getElementById('roiCost').value);

if(investment<=0){

document.getElementById('roiResult').innerHTML=
'<b>Please enter a valid investment amount.</b>';

return;

}

let netBenefit=benefit-cost;

let roi=
((netBenefit-investment)/investment)*100;

let payback=
investment/netBenefit;

let decision=
roi>=20
?'Recommended for further evaluation'
:'Requires management review';

document.getElementById('roiResult').innerHTML=

`
<b>Estimated ROI: ${roi.toFixed(1)}%</b><br>

Net Annual Benefit:
₹${netBenefit.toLocaleString('en-IN')}<br>

Estimated Payback:
${payback.toFixed(2)} years<br>

<b>Decision:</b> ${decision}
`;

}


